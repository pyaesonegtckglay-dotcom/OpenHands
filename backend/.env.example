# ManusAI Backend — Environment Variables
# Copy this to .env and fill in your actual values.
# NEVER commit .env to git.

# App
SECRET_KEY=your-super-secret-key-minimum-32-characters-long
DEBUG=false

# Database (Supabase PostgreSQL via PgBouncer)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Redis (Upstash)
REDIS_URL=rediss://default:password@host:6379

# E2B Sandbox
E2B_API_KEY=your_e2b_api_key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# AI Provider Keys (comma-separated, no spaces)
# Primary: Gemini
GEMINI_API_KEYS=key1,key2,key3

# Fallback 1: GitHub Models (OpenAI-compatible)
GITHUB_MODELS_TOKENS=token1,token2

# Fallback 2: SambaNova
SAMBANOVA_API_KEYS=key1,key2,key3
